#!/bin/bash
# =============================================================
#  dropdown-term — Toggle del terminal desplegable (estilo wlogout)
#
#  Si ya hay una instancia abierta, la mata (toggle off).
#  Si no, la lanza con foco exclusivo de teclado.
#
#  Pensado para llamarlo desde waybar (on-click) o keybindings.
#  La ventana en sí se cierra al perder foco (click fuera), igual
#  que el menú de power (wlogout).
# =============================================================

LOCK="/tmp/dropdown-term.pid"

# Si ya hay un PID vivo → toggle (cerrar)
if [[ -f "$LOCK" ]]; then
    pid="$(cat "$LOCK" 2>/dev/null)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null
        rm -f "$LOCK"
        exit 0
    fi
    rm -f "$LOCK"
fi

# Lanza y guarda
exec python3 __HOME__/scripts/dropdown-term.py "$@"