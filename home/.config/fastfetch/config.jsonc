{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "__HOME__/.config/Kitty-Efeckt/arch.txt",
    "width": 40,
    "height": 19,
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4,
      "bottom": 1
    },
    "color": {
      "1": "#1793d1",
      "2": "#00d2ff",
      "3": "#0369a1"
    }
  },
  "display": {
    "separator": " : "
  },
  "modules": [
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────────┐"
    },
    {
      "type": "title",
      "key": "  ",
      "format": "{1}",
      "keyColor": "blue"
    },
    {
      "type": "command",
      "key": "  ",
      "text": "hostname",
      "keyColor": "blue"
    },
    {
      "type": "os",
      "key": "  󰣇 OS",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "kernel",
      "key": "  Kernel",
      "format": "{2}",
      "keyColor": "red"
    },
    {
      "type": "packages",
      "key": "  󰏗 Packages",
      "keyColor": "green"
    },
    {
      "type": "display",
      "key": "  󰍹 Display",
      "format": "{1}x{2} @ {3}Hz",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "  Terminal",
      "keyColor": "yellow"
    },
    {
      "type": "wm",
      "key": "  WM",
      "format": "{2}",
      "keyColor": "yellow"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────┘"
    },
    "break",
    {
      "type": "cpu",
      "format": "{1}",
      "key": "  CPU",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "format": "{1} {2}",
      "key": "  GPU",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": "  RAM",
      "keyColor": "red"
    },
    {
      "type": "uptime",
      "key": "  Uptime",
      "keyColor": "red"
    },
    {
      "type": "custom",
      "format": "┌────────────────────────────────────────────────┐"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    },
    {
      "type": "custom",
      "format": "└────────────────────────────────────────────────┘"
    }
  ]
}